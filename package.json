{
  "name": "content-factory",
  "version": "0.1.0",
  "description": "A model-agnostic, step-by-step pipeline that turns a topic into a short vertical video, built as small steps an AI agent or a human can run, ending in a built-in human-approval and posting stage.",
  "type": "module",
  "bin": {
    "content-factory": "./factory.mjs"
  },
  "scripts": {
    "test": "node --test test/",
    "example": "node factory.mjs run \"how tides work\" --dry-run",
    "publish": "node factory.mjs publish",
    "run-due": "node factory.mjs publish run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "video",
    "shorts",
    "pipeline",
    "ffmpeg",
    "tts",
    "agents",
    "skills",
    "approval",
    "scheduler",
    "instagram",
    "tiktok",
    "youtube-shorts"
  ],
  "author": "Jet Williams",
  "license": "MIT"
}
