<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd agent: runs `node factory.mjs publish run` every 10 minutes.
  1. Replace /path/to/content-factory and the node path (`which node`).
  2. Copy to ~/Library/LaunchAgents/com.example.content-factory-publish.plist
  3. launchctl load ~/Library/LaunchAgents/com.example.content-factory-publish.plist
  Note: launchd may not be allowed to read folders such as ~/Desktop or ~/Documents (macOS privacy
  controls). Keep the repo and your videos somewhere else, or grant node Full Disk Access.
  Create the publish/logs/ folder first (mkdir -p publish/logs). A sleeping Mac does not run jobs; use
  `node factory.mjs publish schedule <id>` (provider-side scheduling) if that matters.
  Only APPROVED items that are due are posted; drafts are never touched.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.content-factory-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/path/to/content-factory/factory.mjs</string>
    <string>publish</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/content-factory</string>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>/path/to/content-factory/publish/logs/run.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/content-factory/publish/logs/run.log</string>
</dict>
</plist>
