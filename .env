# Copy to .env and fill in only what you use. Real environment variables override this file.
# Nothing here is needed for the dry example: node factory.mjs run "how tides work" --dry-run
# Which adapter each step uses is set in config/factory.config.json ("providers").
# These optional overrides change it for one run: CF_LLM_PROVIDER, CF_TTS_PROVIDER, CF_MUSIC_PROVIDER, CF_CAPTIONS_PROVIDER,
# CF_PUBLISHER

# --- LLM (research + script) ---------------------------------------------
# openai-compatible: any /chat/completions server. Unset base URL = a local server on 127.0.0.1:11434
CF_LLM_BASE_URL=
CF_LLM_API_KEY=
CF_LLM_MODEL=
# command: a CLI that reads the prompt on stdin and prints the answer on stdout
CF_LLM_COMMAND=

# --- Voice ------------------------------------------------------------------
# piper: path to a .onnx voice (its .onnx.json next to it). Check the voice's MODEL_CARD licence before publishing.
CF_PIPER_MODEL=
CF_PIPER_BIN=piper
# command: template with {text_file} and {out}
CF_TTS_COMMAND=

# --- Visuals ----------------------------------------------------------------
# stock (bring your own key)
CF_PEXELS_API_KEY=
# AI image generation (bring your own key). Paid: also set a price + cap in config.
CF_IMAGE_API_KEY=
CF_IMAGE_BASE_URL=
CF_IMAGE_MODEL=
# command: template with {prompt_file} and {out}
CF_IMAGE_COMMAND=

# --- Music ------------------------------------------------------------------
# strudel-command: your own, separately installed renderer. Template with {pattern} {seconds} {out}
CF_STRUDEL_RENDER_CMD=
# command: any other engine or an AI music API wrapper. Template with {seconds} {out} {prompt} {pattern}
CF_MUSIC_COMMAND=

# --- Captions ---------------------------------------------------------------
# command: any aligner / speech-to-text with word times. Template with {audio} {text_file} {out}
CF_ALIGN_COMMAND=

# --- Publish (the queue + human approval gate) -------------------------------
# The publisher is set in config/factory.config.json ("providers.publisher"). The default "dry" never posts.
# Optional one-run overrides (paths relative to the repo root, or absolute):
# CF_PUBLISHER=upload-post
# CF_PUBLISH_QUEUE=publish/queue/queue.json
# CF_PUBLISH_STATS=publish/data/stats.jsonl
# CF_PUBLISH_LOG_FILE=publish/logs/publish.log
# FFPROBE_PATH=ffprobe

# upload-post (https://www.upload-post.com): API key from its dashboard, and the profile your accounts are connected to.
# Other options (AI label, privacy, category, polling) are in config "publish" -> "upload-post";
# UPLOAD_POST_AI_LABEL, UPLOAD_POST_TIKTOK_PRIVACY, UPLOAD_POST_YOUTUBE_PRIVACY, ... override them.
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Optional Telegram approval bot (examples/telegram-approval). Never commit these.
TELEGRAM_BOT_TOKEN=
# comma-separated numeric Telegram user IDs allowed to approve
TELEGRAM_APPROVER_IDS=
